---
permalink: /archive/index.html
layout: base.liquid
title: The Archive
currentNav: /archive/
---
<div class="u-burrito">
  <blog-prose data-component>
    <h1>The Archive</h1>
    <h2>Categories</h2>
  </blog-prose>

  <section>
    <p>
      {% assign tags = blog.categories | map: 'slug' %}
      {% include 'components/post-tags/post-tags', tags: tags, size: 'large' %}
    </p>
  </section>

  {% for yearGroup in blog.years %}
    {% capture year_title %}
      <blog-prose data-component data-links-to-post>
        <h3>
          <a href="/in/{{ yearGroup.year }}/">{{ yearGroup.year }}</a>
        </h3>
      </blog-prose>
    {% endcapture %}
    <section>
      {% include 'components/post-overview/post-overview',
        posts: yearGroup.posts,
        title: year_title %}
    </section>
  {% endfor %}
</div>
