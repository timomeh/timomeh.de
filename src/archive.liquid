---
permalink: /archive/index.html
layout: base.liquid
title: The Archive
currentNav: /archive/
---
<div class="u-burrito" style="--prose-linked-heading: h2">
  <blog-prose data-component>
    <h1>The Archive</h1>
    <section>
      <h2 id="categories">
        Categories
        <a href="#categories" class="heading-anchor" aria-label="Link to categories">#</a>
      </h2>
      <p style="--post-tags-size: large">
        {% assign tags = blog.categories | map: 'slug' %}
        {% include 'components/post-tags/post-tags', tags: tags %}
      </p>
    </section>

    {% for yearGroup in blog.years %}
      <section>
        <h2 id="{{ yearGroup.year }}">
          <a href="/in/{{ yearGroup.year }}/">{{ yearGroup.year }}</a>
          <a href="#{{ yearGroup.year }}" class="heading-anchor" aria-label="Link to {{ yearGroup.year }}">#</a>
        </h2>
        {% include 'components/post-overview/post-overview', posts: yearGroup.posts %}
      </section>
    {% endfor %}
  </blog-prose>
</div>
