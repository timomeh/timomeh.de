<!doctype html>
<html lang="en" data-theme="system" data-color-scheme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#E8E7E4" data-swup-theme>
    <script>
      (() => {
        let preference = 'system';
        try { preference = localStorage.getItem('theme') || 'system'; } catch {}
        if (!['light', 'dark', 'system'].includes(preference)) preference = 'system';
        const root = document.documentElement;
        root.dataset.theme = preference;
        root.dataset.colorScheme = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
        document.querySelector('meta[name="theme-color"]').content = root.dataset.colorScheme === 'dark' ? '#0D0D0B' : '#E8E7E4';
      })();
    </script>
    {% include 'metadata.liquid' %}
    <link rel="alternate" type="application/rss+xml" title="All RSS" href="/all/feed.rss">
    <link rel="alternate" type="application/atom+xml" title="All Atom" href="/all/feed.atom">
    <link rel="alternate" type="application/feed+json" title="All JSON Feed" href="/all/feed.json">
    <link rel="alternate" type="application/rss+xml" title="Posts RSS" href="/posts/feed.rss">
    <link rel="alternate" type="application/atom+xml" title="Posts Atom" href="/posts/feed.atom">
    <link rel="alternate" type="application/feed+json" title="Posts JSON Feed" href="/posts/feed.json">
    <link rel="alternate" type="application/rss+xml" title="Shorts RSS" href="/shorts/feed.rss">
    <link rel="alternate" type="application/atom+xml" title="Shorts Atom" href="/shorts/feed.atom">
    <link rel="alternate" type="application/feed+json" title="Shorts JSON Feed" href="/shorts/feed.json">
    <style>
      @layer reset, vendor, theme, base, components, utilities, overrides;
    </style>
    <link rel="stylesheet" href="{{ 'src/css/reset.css' | cssUrl }}">
    <link rel="stylesheet" href="{{ 'src/css/vendor/fancybox.css' | cssUrl }}">
    <link rel="stylesheet" href="{{ 'src/css/shiki.css' | cssUrl }}">
    <link rel="stylesheet" href="{{ 'src/css/theme.css' | cssUrl }}">
    <link rel="stylesheet" href="{{ 'src/css/fonts.css' | cssUrl }}">
    <link rel="stylesheet" href="{{ 'src/css/base.css' | cssUrl }}">
    <link rel="stylesheet" href="{{ 'src/css/utilities.css' | cssUrl }}">
    {% getBundle "componentStyles" %}
    <script type="importmap">
    {
      "imports": {
        "site/swup": "{{ 'src/js/swup.mjs' | jsUrl }}",
        "site/shaders": "{{ 'src/js/shaders.mjs' | jsUrl }}"
      }
    }
    </script>
    <link rel="modulepreload" href="{{ 'src/js/shaders.mjs' | jsUrl }}">
    <script defer src="{{ 'src/js/vendor/fancybox.umd.js' | jsUrl }}"></script>
    <script defer src="{{ 'src/js/vendor/swup.umd.js' | jsUrl }}"></script>
    <script defer src="{{ 'src/js/vendor/swup-head-plugin.umd.js' | jsUrl }}"></script>
    <script defer src="{{ 'src/js/vendor/swup-a11y-plugin.umd.js' | jsUrl }}"></script>
    <script defer src="{{ 'src/js/vendor/swup-parallel-plugin.umd.js' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/swup.mjs' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/page-transitions.mjs' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/lightbox.mjs' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/animated-header-cover.mjs' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/random-kicker.mjs' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/nav-bar.mjs' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/nav-bar-menu.mjs' | jsUrl }}"></script>
    <script type="module" src="{{ 'src/js/theme-toggle.mjs' | jsUrl }}"></script>
    <script defer src="https://oralytik.timo.wtf/script.js" data-website-id="ba2c9033-714b-4daf-acdb-a07a577f5bec" data-performance="true"></script>

    <style>
      :root {
        --base-layout-hide-header-backdrop: {{ post.hasCover | default: false }}
      }
    </style>
  </head>
  <body>
    {% linkCSS 'src/_includes/components/prose.css' %}
    {% linkCSS 'src/_includes/components/content-image/content-image.css' %}
    {% linkCSS 'src/_includes/components/base-layout.css' %}
    <blog-base-layout data-component>
      <a class="u-skipLink" href="#page-content" data-no-swup>Skip to main content</a>
      <div
        id="page-backdrop"
        class="layout-backdrop"
        style="
          {% if post.cover.lightColor %}
            --post-light-bg: {{ post.cover.lightColor | escape }};
            --post-light-blend: multiply;
          {% endif %}
          {% if post.cover.darkColor %}
            --post-dark-bg: {{ post.cover.darkColor | escape }};
            --post-dark-blend: exclusion;
          {% endif %}
        "
      ></div>

      <div class="layout-cover" id="page-cover">
        {% if post.cover.lightImage or post.cover.darkImage %}
          {% include 'components/post-cover/post-cover',
             dark: post.cover.darkImage,
             light: post.cover.lightImage %}
        {% endif %}
      </div>

      <div class="top-backdrop">
        {% include 'components/header-backdrop/header-backdrop' %}
      </div>

      {% include 'components/nav-bar/nav-bar', currentNav: currentNav %}

      {% assign kicker = post.frontmatter.kicker | default: pageContent.frontmatter.kicker | default: short.frontmatter.kicker | default: category.frontmatter.kicker %}
      {% include 'components/page-header/page-header', kicker: kicker %}

      {% include 'browser-warning' %}

      <main id="page-content" tabindex="-1">
        <a class="u-skipLink" href="#site-nav" data-no-swup>Skip to navigation</a>
        {{ content }}
      </main>
      {% include 'components/page-footer/page-footer' %}
    </blog-base-layout>
  </body>
</html>
