{% linkCSS 'src/_includes/components/post-preview/post-preview.css' %}
{% linkCSS 'src/_includes/components/read-more.css' %}

<blog-post-preview style="
  {% if post.cover.lightColor %}
    --post-light-bg: {{ post.cover.lightColor | escape }};
    --post-light-grain: var(--page-grain);
  {% endif %}
  {% if post.cover.darkColor %}
    --post-dark-bg: {{ post.cover.darkColor | escape }};
    --post-dark-grain: var(--page-grain);
  {% endif %}"
>
  <article>
    {% if post.cover.lightImage or post.cover.darkImage %}
      {% include 'components/post-cover/post-cover',
          lazy: true,
          light: post.cover.lightImage,
          dark: post.cover.darkImage %}
    {% endif %}
    <div class="content u-burrito">
      {% include 'components/post-eyebrow/post-eyebrow', linked: true, tags: post.tags %}
      <div class="body">
        <blog-prose data-component data-links-to-post>
          {{ post.excerptHtml }}
        </blog-prose>
      </div>
    </div>
  </article>
</blog-post-preview>
