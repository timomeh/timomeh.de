{% linkCSS 'src/_includes/components/post-view/post-view.css' %}

<blog-post-view data-component>
  <article
    class="u-burrito"
    {% if post.meta.lang %}
      lang="{{ post.meta.lang | split: '_' | first | escape }}"
    {% endif %}
  >
    {% include 'components/post-eyebrow/post-eyebrow', tags: post.tags, linked: false %}
    <div class="body">
      <blog-prose data-component>{{ post.html }}</blog-prose>
    </div>
  </article>
</blog-post-view>
