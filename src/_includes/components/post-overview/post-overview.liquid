{% linkCSS 'src/_includes/components/post-overview/post-overview.css' %}

<blog-post-overview data-component>
  <ol>
    {% for post in posts %}
      <li>
        {% include 'components/post-eyebrow/post-eyebrow', linked: true, tags: post.tags %}
        <blog-prose data-component>
          <h3>
            <a href="{{ post.url | escape }}">{{ post.title | escape }}</a>
          </h3>
        </blog-prose>
      </li>
    {% endfor %}
  </ol>
</blog-post-overview>
