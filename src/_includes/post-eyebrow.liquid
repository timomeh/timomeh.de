<div class="PostEyebrow">
  {% if post.tags.size > 0 %}
    <div>
      {% for tag in post.tags %}
        {% assign tag_data = blog.categories | where: 'slug', tag | first %}
        <a
          class="PostEyebrow-tag"
          href="/categories/{{ tag | url_encode }}/"
          {% if tag_data.color %}
            style="--tag-color: {{ tag_data.color | escape }}"
          {% endif %}
        >
          {{ tag_data.title | default: tag | escape }}</a>
        {%- unless forloop.last %}, {% endunless %}
      {% endfor %}
    </div>
  {% endif %}
  <div>
    {% if eyebrow_linked %}
      <a class="PostEyebrow-permalink" href="{{ post.url }}">
    {% endif %}
    <time class="PostEyebrow-date" datetime="{{ post.publishedAt | dateIso }}">{{ post.publishedAt | postDate }}</time>
    {%- if eyebrow_linked %}</a>{% endif %},
    {{ post.readingTime | escape }}
  </div>
</div>
