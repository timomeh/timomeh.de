---
layout: base.liquid
title: Posts
---
<ol class="PostList">
  {% for item in blog.timeline %}
    <li class="PostList-item">
      {% if item.type == 'post' %}
        {% include 'post-preview.liquid', post: item.entry %}
      {% else %}
        {% include 'shorts-group.liquid', shorts: item.items %}
      {% endif %}
    </li>
  {% endfor %}
</ol>
