---
pagination:
  data: blog.posts
  size: 1
  alias: post
permalink: "{{ post.url }}index.html"
layout: base.liquid
eleventyComputed:
  title: "{{ post.title }}"
currentNav: /posts/
---
{% include 'components/post-view/post-view', post: post %}

<section class="u-burrito">
  {% capture related_posts_title %}
    <h2>More like this</h2>
  {% endcapture %}
  {% include 'components/post-overview/post-overview',
    posts: post.relatedPosts,
    title: related_posts_title %}
</section>
