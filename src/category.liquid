---
pagination:
  data: blog.categories
  size: 1
  alias: category
permalink: "{{ category.url }}index.html"
layout: base.liquid
eleventyComputed:
  title: "{{ category.title }}"
currentNav: /archive/
---
<div class="u-burrito">
  <blog-prose data-component>
    <h1>{{ category.posts.size }} {{ category.posts.size | pluralize: 'post', 'posts' }} tagged {{ category.title | escape }}</h1>
    <p>{{ category.description | escape }}</p>
  </blog-prose>
</div>
{% include 'components/post-timeline/post-timeline', items: category.posts %}
